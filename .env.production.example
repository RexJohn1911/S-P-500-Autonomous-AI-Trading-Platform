# =========================================================================
# S&P 500 Autonomous AI Trading Platform - Production Environment Template
# Fill all values via secure runtime secrets injection (e.g., Vault / Secrets Manager).
# NEVER commit completed files with real credentials to source control.
# =========================================================================

# Core Application Settings
PROJECT_NAME="S&P 500 Autonomous AI Trading System"
ENVIRONMENT=production
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000
WORKERS_COUNT=1
SECRET_KEY=ROTATE_THIS_TO_A_CRYPTOGRAPHICALLY_SECURE_64_CHAR_HEX_KEY
ALLOWED_ORIGINS=["https://trading.yourdomain.com"]
SERVE_STATIC_FRONTEND=true
STATIC_DIR=frontend/dist

# Execution Mode (MUST default to PAPER unless explicitly authorized for LIVE)
EXECUTION_MODE=PAPER

# Broker Configuration
BROKER_PROVIDER=PAPER
BROKER_EXECUTION_MODE=PAPER
BROKER_TIMEOUT_SECONDS=30.0
BROKER_MAX_RETRIES=3

# Alpaca Runtime Credentials (Injected at runtime)
ALPACA_API_KEY=
ALPACA_API_SECRET=
ALPACA_BASE_URL=https://paper-api.alpaca.markets
ALPACA_PAPER_URL=https://paper-api.alpaca.markets
ALPACA_RATE_LIMIT_PER_MINUTE=200

# Database & Cache (PostgreSQL & Redis)
DATABASE_URL=postgresql+asyncpg://trading_user:SECURE_DB_PASSWORD@postgres:5432/sp500_trading_prod
DATABASE_SYNC_URL=postgresql://trading_user:SECURE_DB_PASSWORD@postgres:5432/sp500_trading_prod
REDIS_URL=redis://redis:6379/0

# Risk Engine Constraints (Hard limit compliance)
RISK_ENGINE_ENABLED=true
RISK_MAX_POSITION_WEIGHT=0.10
RISK_MAX_GROSS_EXPOSURE=1.00
RISK_MAX_NET_EXPOSURE=1.00
RISK_MAX_LONG_EXPOSURE=1.00
RISK_MAX_SHORT_EXPOSURE=1.00
RISK_MAX_POSITIONS=20
RISK_MAX_LEVERAGE=1.00
RISK_ADJUSTMENT_ENABLED=true
RISK_VERSION=risk-v1.1

# Monitoring & Safety (Phase 18)
MONITORING_ENABLED=true
MONITORING_HEARTBEAT_TIMEOUT_SECONDS=60.0
MONITORING_MAX_CYCLE_DURATION_SECONDS=120.0
MONITORING_MAX_CONSECUTIVE_FAILURES=3
MONITORING_MAX_BROKER_LATENCY_MS=5000.0
MONITORING_MAX_DATA_STALENESS_SECONDS=432000.0
MONITORING_MAX_RECONCILIATION_AGE_SECONDS=300.0
MONITORING_ALERT_DEDUP_WINDOW_SECONDS=60.0
MONITORING_AUTO_KILL_SWITCH_ENABLED=true
MONITORING_STORAGE_DIR=models/monitoring
MONITORING_VERSION=monitoring-v1.0
