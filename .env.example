# =========================================================================
# S&P 500 Autonomous AI Trading Platform - Development Environment Template
# NEVER commit real API keys, passwords, or secrets to version control.
# =========================================================================

# Core Application Settings
PROJECT_NAME="S&P 500 Autonomous AI Trading System"
ENVIRONMENT=development
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000
WORKERS_COUNT=1
SECRET_KEY=dev-secret-key-for-local-sp500-ai-trading-system-32chars
ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:5173","http://localhost:8000","http://127.0.0.1:5173","http://127.0.0.1:8000"]
SERVE_STATIC_FRONTEND=true
STATIC_DIR=frontend/dist

# Trading Execution Configuration (Default: PAPER)
EXECUTION_MODE=PAPER

# Broker Configuration (Alpaca / Paper)
BROKER_PROVIDER=PAPER
BROKER_EXECUTION_MODE=PAPER
BROKER_API_KEY=your_paper_broker_api_key
BROKER_SECRET_KEY=your_paper_broker_secret_key
BROKER_BASE_URL=https://paper-api.alpaca.markets

# Alpaca Live Credentials (Runtime injected only when authorized)
ALPACA_API_KEY=
ALPACA_API_SECRET=
ALPACA_BASE_URL=https://api.alpaca.markets
ALPACA_PAPER_URL=https://paper-api.alpaca.markets
ALPACA_RATE_LIMIT_PER_MINUTE=200

# Market Data Providers
DATA_PROVIDER=alpaca
DATA_PROVIDER_API_KEY=your_data_provider_key

# Database & Cache (PostgreSQL & Redis)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/sp500_trading_db
DATABASE_SYNC_URL=postgresql://postgres:postgres@localhost:5432/sp500_trading_db
REDIS_URL=redis://localhost:6379/0

# Risk Parameters & Circuit Breakers (Phase 12 Hardening)
RISK_ENGINE_ENABLED=true
RISK_MAX_POSITION_WEIGHT=0.10
RISK_MAX_GROSS_EXPOSURE=1.00
RISK_MAX_NET_EXPOSURE=1.00
RISK_MAX_LONG_EXPOSURE=1.00
RISK_MAX_SHORT_EXPOSURE=1.00
RISK_MAX_POSITIONS=20
RISK_MAX_LEVERAGE=1.00
RISK_ADJUSTMENT_ENABLED=true
RISK_VERSION=risk-v1.1

# Paper Trading Parameters (Phase 14)
PAPER_TRADING_ENABLED=true
PAPER_INITIAL_CAPITAL=100000.0
PAPER_BASE_CURRENCY=USD
PAPER_COMMISSION_RATE=0.0005
PAPER_SLIPPAGE_RATE=0.0005
PAPER_SPREAD_RATE=0.0002
PAPER_MARKET_IMPACT_COEFF=0.0
PAPER_BORROW_RATE=0.0
PAPER_MIN_ORDER_NOTIONAL=10.0
PAPER_MIN_POSITION_DELTA=0.001
PAPER_MAX_OPEN_ORDERS=100
PAPER_EXECUTION_MODE=simulated
PAPER_IDEMPOTENCY_ENABLED=true
PAPER_SESSION_VERSION=paper-v1.0

# Autonomous Trading Loop (Phase 15)
AUTONOMOUS_LOOP_ENABLED=true
AUTONOMOUS_SCHEDULE_INTERVAL=daily
AUTONOMOUS_MAX_STALE_TOLERANCE_SECONDS=432000.0
AUTONOMOUS_MISSING_SYMBOL_POLICY=FAIL_CLOSED
AUTONOMOUS_MAX_RETRY_ATTEMPTS=3
AUTONOMOUS_RETRY_BACKOFF_BASE_SECONDS=1.0
AUTONOMOUS_AUTO_CHECKPOINT_ENABLED=true
AUTONOMOUS_VERSION=autonomous-v1.0

# Monitoring & Safety (Phase 18)
MONITORING_ENABLED=true
MONITORING_HEARTBEAT_TIMEOUT_SECONDS=60.0
MONITORING_MAX_CYCLE_DURATION_SECONDS=120.0
MONITORING_MAX_CONSECUTIVE_FAILURES=3
MONITORING_MAX_BROKER_LATENCY_MS=5000.0
MONITORING_MAX_DATA_STALENESS_SECONDS=432000.0
MONITORING_MAX_RECONCILIATION_AGE_SECONDS=300.0
MONITORING_ALERT_DEDUP_WINDOW_SECONDS=60.0
MONITORING_AUTO_KILL_SWITCH_ENABLED=true
MONITORING_STORAGE_DIR=models/monitoring
MONITORING_VERSION=monitoring-v1.0
